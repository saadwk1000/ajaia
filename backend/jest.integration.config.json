{
  "testEnvironment": "node",
  "roots": ["<rootDir>/test"],
  "testMatch": ["**/*.integration-spec.ts"],
  "extensionsToTreatAsEsm": [".ts"],
  "transform": { "^.+\\.tsx?$": ["ts-jest", { "useESM": true, "tsconfig": "tsconfig.json" }] },
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "testTimeout": 60000
}
