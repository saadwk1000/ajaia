# API project variables for Vercel Production/Preview. Fill real values in project settings.
# Use the provider's pooled, TLS-verified PostgreSQL URL for runtime.
DATABASE_URL=
# Optional direct PostgreSQL URL for migrations; never expose either URL in the frontend.
DIRECT_URL=
# Required frontend HTTPS origin, without /path or trailing slash.
FRONTEND_ORIGIN=
# Optional comma-separated exact HTTPS preview/custom-domain frontend origins.
ADDITIONAL_FRONTEND_ORIGINS=
NODE_ENV=production
# Do not override Vercel's runtime PORT; this is for standalone Node execution.
PORT=4000
TRUST_PROXY=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=10000
# VERCEL, VERCEL_ENV and VERCEL_URL are supplied by Vercel, not the client.
