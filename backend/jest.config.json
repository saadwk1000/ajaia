{
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/*.spec.ts"],
  "extensionsToTreatAsEsm": [".ts"],
  "transform": { "^.+\\.tsx?$": ["ts-jest", { "useESM": true, "tsconfig": "tsconfig.json" }] },
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "collectCoverageFrom": ["src/**/*.ts", "!src/generated/**", "!src/main.ts"]
}
