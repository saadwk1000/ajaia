# Required: paste the deployed NestJS API origin, e.g. https://your-api-project.vercel.app
# Do not append /api/v1. This server-only variable is read when Next.js builds rewrites.
# Add API_URL to the frontend Vercel project Environment Variables and redeploy after changes.
API_URL=

# Vercel/Next.js supplies NODE_ENV, VERCEL, VERCEL_ENV and VERCEL_URL; do not add them here.
